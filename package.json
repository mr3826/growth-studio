{
  "name": "kinetic-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=apps/local-server run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev": "node scripts/dev.js",
    "build": "npm --workspace=apps/web run build",
    "start": "npm --workspace=apps/local-server run start",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "test:matrix": "node tests/matrix.test.js",
    "test:creative": "node tests/live-creative.standalone.js"
  }
}
