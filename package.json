{
  "name": "kinetic-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=apps/local-server run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev": "node scripts/dev.js",
    "build": "npm --workspace=apps/web run build",
    "start": "npm --workspace=apps/local-server run start",
    "test": "node scripts/run-tests.js",
    "test:matrix": "node scripts/run-tests.js tests/matrix.test.js",
    "test:creative": "node scripts/run-tests.js tests/creative.test.js",
    "test:creative:live": "node scripts/run-tests.js tests/live-creative.standalone.js"
  }
}
