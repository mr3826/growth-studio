{
  "schemaVersion": "1.0",
  "project": {
    "id": "easymoderator-launch",
    "name": "EasyModerator Launch Film",
    "campaignName": "Merchant productivity",
    "language": "mixed",
    "clientOrProduct": "EasyModerator"
  },
  "template": {
    "id": "problem_solution",
    "version": "1.0.0",
    "variant": "bold"
  },
  "creative": {
    "objective": "awareness",
    "audience": "Bangladesh Facebook shop owners",
    "painPoint": "Handling many customer messages manually",
    "keyMessage": "Make customer conversations easier to manage",
    "tone": "bold",
    "languageStyle": "mixed",
    "platforms": [
      "facebook_reels",
      "youtube",
      "website"
    ],
    "claimEvidenceNotes": "Use only verified EasyModerator product features and approved demo screenshots",
    "requiredPhrases": [
      "EasyModerator"
    ],
    "prohibitedPhrases": [
      "Guaranteed more sales",
      "Replace all employees"
    ],
    "cta": {
      "label": "Explore EasyModerator",
      "destination": "https://easymod.tech"
    }
  },
  "brand": {
    "name": "EasyModerator",
    "tagline": "Manage conversations. Stay in control.",
    "primaryColor": "#7460D9",
    "backgroundColor": "#17223B",
    "textColor": "#FFFFFF",
    "accentColor": "#F4C35E",
    "latinFontFamily": "Inter",
    "banglaFontFamily": "Noto Sans Bengali",
    "fontWeight": 800,
    "cornerRadiusPx": 16,
    "stylePreset": "bold_future",
    "logoPlacement": "outro",
    "watermark": false
  },
  "assets": [
    {
      "id": "logo",
      "kind": "logo",
      "file": "assets/logo.png",
      "usageRights": "owner"
    },
    {
      "id": "inbox",
      "kind": "image",
      "file": "assets/inbox-demo.png",
      "usageRights": "owner",
      "fit": "contain"
    },
    {
      "id": "music",
      "kind": "music",
      "file": "assets/background-music.wav",
      "usageRights": "licensed"
    }
  ],
  "targets": [
    {
      "id": "portrait",
      "width": 1080,
      "height": 1920,
      "fps": 30,
      "safeMarginPercent": 9,
      "fitMode": "reflow"
    },
    {
      "id": "landscape",
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "safeMarginPercent": 7,
      "fitMode": "reflow"
    }
  ],
  "scenes": [
    {
      "id": "hook",
      "kind": "kinetic_text",
      "durationSeconds": 5,
      "eyebrow": "THE CHALLENGE",
      "headline": "Too many messages?",
      "subheadline": "Too little time?",
      "highlightWords": [
        "messages"
      ],
      "layout": "centered",
      "motion": {
        "entrance": "stagger_words",
        "emphasis": "highlight",
        "exit": "fade",
        "easing": "spring",
        "intensity": 0.72,
        "staggerMilliseconds": 70
      },
      "afterTransition": "crossfade",
      "transitionDurationSeconds": 0.3
    },
    {
      "id": "problem",
      "kind": "problem",
      "durationSeconds": 5,
      "headline": "Running your shop should feel simpler.",
      "body": "Messages, questions, and orders need attention.",
      "layout": "centered",
      "motion": {
        "entrance": "slide_left",
        "exit": "fade",
        "easing": "ease_out"
      }
    },
    {
      "id": "reveal",
      "kind": "solution",
      "durationSeconds": 6,
      "headline": "Meet EasyModerator",
      "subheadline": "A better way to manage conversations.",
      "layout": "centered",
      "mediaAssetIds": [
        "logo"
      ],
      "motion": {
        "entrance": "scale_pop",
        "exit": "fade",
        "easing": "spring"
      }
    },
    {
      "id": "demo",
      "kind": "ui_demo",
      "durationSeconds": 8,
      "headline": "See your conversations in action",
      "subheadline": "Real interface. Clear merchant control.",
      "mediaAssetIds": [
        "inbox"
      ],
      "layout": "device_mockup",
      "deviceFrame": "browser_window",
      "cameraZoom": 1.15,
      "motion": {
        "entrance": "mask_reveal",
        "exit": "slide_left",
        "easing": "ease_in_out"
      }
    },
    {
      "id": "cta",
      "kind": "cta",
      "durationSeconds": 6,
      "headline": "Take control of your conversations.",
      "subheadline": "EasyModerator",
      "ctaLabel": "Explore EasyModerator",
      "ctaDestination": "https://easymod.tech",
      "mediaAssetIds": [
        "logo"
      ],
      "layout": "centered",
      "motion": {
        "entrance": "fade_up",
        "exit": "fade",
        "easing": "ease_out"
      }
    }
  ],
  "audio": {
    "musicAssetId": "music",
    "musicVolume": 0.22,
    "fadeInSeconds": 0.4,
    "fadeOutSeconds": 0.8,
    "duckMusicUnderVoice": true,
    "beatSync": "off"
  },
  "captions": {
    "enabled": false,
    "source": "scene_text",
    "position": "bottom",
    "maxWordsPerLine": 5
  },
  "export": {
    "fileStem": "easymoderator-launch",
    "format": "mp4",
    "videoCodec": "h264",
    "audioCodec": "aac",
    "qualityPreset": "high",
    "workers": 1,
    "useGpuIfAvailable": false,
    "overwriteExisting": false,
    "includeProjectArchive": true,
    "includeThumbnail": true,
    "keepIntermediates": false
  }
}
